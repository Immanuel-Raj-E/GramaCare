{\rtf1\ansi\deff0{\fonttbl{\f0 Times New Roman;}}\f0\fs28 \b CHAPTER 5: IMPLEMENTATION & CODE VERIFICATION\b0\line \b GRAMACARE - RURAL HEALTHCARE MANAGEMENT PLATFORM\b0\line\line \b 5.2.1 Project Structure\b0\line\line gramacare/\line ├── backend/\line │   ├── src/\line │   │   ├── config/\line │   │   │   └── db.js                 # MongoDB connection & reconnection handler\line │   │   ├── controllers/\line │   │   │   ├── authController.js      # Register, login, getMe, logout\line │   │   │   ├── patientController.js   # Patient profile & health summary\line │   │   │   ├── doctorController.js    # Doctor profile, queue & patient directory\line │   │   │   ├── appointmentController.js # Booking, conflict prevention & status transitions\line │   │   │   ├── medicalRecordController.js # Clinical EHR note creation & history\line │   │   │   ├── prescriptionController.js # Multi-medicine digital Rx generator\line │   │   │   ├── medicalReportController.js # Multer file upload & report viewing\line │   │   │   ├── messageController.js   # Doctor-patient consultative chat\line │   │   │   ├── notificationController.js # Event alerts & read status updates\line │   │   │   └── adminController.js     # Platform analytics, doctor audits & user toggles\line │   │   ├── middleware/\line │   │   │   ├── authMiddleware.js      # JWT token extraction & verification (protect)\line │   │   │   ├── roleMiddleware.js      # Role-based access control (authorize)\line │   │   │   └── errorMiddleware.js     # Centralized 404 & error handlers\line │   │   ├── models/\line │   │   │   ├── User.js, Patient.js, Doctor.js, Appointment.js,\line │   │   │   ├── MedicalRecord.js, Prescription.js, MedicalReport.js,\line │   │   │   └── Message.js, Notification.js\line │   │   ├── routes/                    # Express modular route definitions\line │   │   ├── services/                  # Notification & auxiliary business logic\line │   │   ├── utils/\line │   │   │   ├── apiResponse.js         # Centralized success/error JSON wrappers\line │   │   │   ├── generateToken.js       # Signed JWT generator\line │   │   │   ├── seedAdmin.js           # Default platform admin seeder\line │   │   │   └── seedDemoData.js        # Verified doctor & rural patient demo seeders\line │   │   ├── app.js                     # Express middleware & route mounting\line │   │   └── server.js                  # HTTP server bootstrap & DB initialization\line │   ├── tests/                         # Automated test suites\line │   ├── uploads/reports/               # Local binary storage for lab report files\line │   └── package.json\line ├── frontend/\line │   ├── src/\line │   │   ├── components/common/         # Navbar, Footer, UI Cards\line │   │   ├── context/\line │   │   │   └── AuthContext.jsx        # Global session provider & demo auto-login\line │   │   ├── hooks/\line │   │   │   └── useAuth.js             # AuthContext consumer hook\line │   │   ├── layouts/\line │   │   │   ├── PatientLayout.jsx      # Patient portal sidebar & shell\line │   │   │   ├── DoctorLayout.jsx       # Doctor clinical workspace sidebar\line │   │   │   └── AdminLayout.jsx        # Admin governance console sidebar\line │   │   ├── pages/\line │   │   │   ├── public/                # LandingPage, Login, Register, Unauthorized\line │   │   │   ├── patient/               # Dashboard, Appointments, Records, Rx, Reports, Chat\line │   │   │   ├── doctor/                # Dashboard, Queue, Patients, EHR, Prescriptions, Timings\line │   │   │   └── admin/                 # Overview Stats, Doctor Verification, User Directory\line │   │   ├── routes/\line │   │   │   ├── AppRoutes.jsx          # Declarative React Router v7 configuration\line │   │   │   └── ProtectedRoute.jsx     # Route guard wrapper\line │   │   ├── services/\line │   │   │   ├── api.js                 # Centralized Axios client with JWT interceptors\line │   │   │   ├── authService.js, patientService.js, doctorService.js, adminService.js\line │   │   ├── App.jsx\line │   │   └── main.jsx\line │   ├── tailwind.config.js\line │   └── package.json\line ├── .env.example\line ├── .gitignore\line └── README.md\line\line ----------------------------------------------------------------------\line\line \b 5.2.2 Package Installation & Verified Versions\b0\line\line The platform is built on Node.js (v24.8.0) using production-grade libraries without bloated third-party dependencies:\line \line Backend Dependencies (backend/package.json):\line npm install express@^5.2.1 mongoose@^9.10.3 dotenv@^18.0.5 cors@^2.8.6 jsonwebtoken@^9.0.3 bcryptjs@^3.0.3 multer@^2.4.0\line npm install --save-dev nodemon@^3.1.14\line \line Frontend Dependencies (frontend/package.json):\line npm create vite@latest frontend -- --template react\line cd frontend\line npm install axios@^1.20.0 react-router-dom@^7.18.4 lucide-react@^1.49.0\line npm install --save-dev tailwindcss@^3.4.19 postcss@^8.5.28 autoprefixer@^10.6.1\line npx tailwindcss init -p\line\line ----------------------------------------------------------------------\line\line \b 5.2.3 Database Connection (backend/src/config/db.js)\b0\line\line // MongoDB connection & reconnection lifecycle handler\line const mongoose = require('mongoose');\line \line const connectDB = async () => \{\line   try \{\line     const mongoUri = process.env.MONGO_URI || 'mongodb://127.0.0.1:27017/gramacare';\line     const conn = await mongoose.connect(mongoUri);\line     console.log(`[MongoDB] Connected successfully: $\{conn.connection.host\}/$\{conn.connection.name\}`);\line   \} catch (error) \{\line     console.error(`[MongoDB] Connection error: $\{error.message\}`);\line     process.exit(1);\line   \}\line \};\line \line mongoose.connection.on('disconnected', () => \{\line   console.warn('[MongoDB] Connection lost. Attempting reconnection...');\line \});\line \line module.exports = connectDB;\line\line ----------------------------------------------------------------------\line\line \b 5.2.4 Environment Variables (.env.example)\b0\line\line # Backend Server Configuration\line PORT=5000\line NODE_ENV=development\line \line # Database Configuration\line MONGO_URI=mongodb://127.0.0.1:27017/gramacare\line \line # JWT Authentication Configuration\line JWT_SECRET=gramacare_super_secret_jwt_key_2026_rural_health\line JWT_EXPIRE=7d\line \line # Client Application URL for CORS Whitelisting\line CLIENT_URL=http://localhost:5173\line\line ----------------------------------------------------------------------\line\line \b 5.2.5 User Model (backend/src/models/User.js)\b0\line\line // Core User Mongoose schema with automated password hashing\line const mongoose = require('mongoose');\line const bcrypt = require('bcryptjs');\line \line const userSchema = new mongoose.Schema(\line   \{\line     name: \{\line       type: String,\line       required: [true, 'Please provide a full name'],\line       trim: true\line     \},\line     email: \{\line       type: String,\line       required: [true, 'Please provide an email address'],\line       unique: true,\line       lowercase: true,\line       trim: true,\line       match: [\line         /^\\w+([\\.-]?\\w+)*@\\w+([\\.-]?\\w+)*(\\.\\w\{2,3\})+$/,\line         'Please provide a valid email address'\line       ]\line     \},\line     phone: \{\line       type: String,\line       required: [true, 'Please provide a contact phone number'],\line       trim: true\line     \},\line     password: \{\line       type: String,\line       required: [true, 'Please provide a password'],\line       minlength: [8, 'Password must be at least 8 characters long'],\line       select: false // Excluded from default queries for security\line     \},\line     role: \{\line       type: String,\line       enum: ['patient', 'doctor', 'admin'],\line       default: 'patient',\line       required: true\line     \},\line     isActive: \{\line       type: Boolean,\line       default: true\line     \}\line   \},\line   \{ timestamps: true \}\line );\line \line // Encrypt password before saving\line userSchema.pre('save', async function () \{\line   if (!this.isModified('password')) return;\line   const salt = await bcrypt.genSalt(10);\line   this.password = await bcrypt.hash(this.password, salt);\line \});\line \line // Compare entered password with stored hash\line userSchema.methods.matchPassword = async function (enteredPassword) \{\line   return await bcrypt.compare(enteredPassword, this.password);\line \};\line \line module.exports = mongoose.model('User', userSchema);\line\line ----------------------------------------------------------------------\line\line \b 5.2.6 Registration and Profile Initialization (authController.js)\b0\line\line const register = async (req, res) => \{\line   try \{\line     const \{ name, email, phone, password, role = 'patient', ...profileFields \} = req.body;\line \line     if (!name || !email || !phone || !password) \{\line       return errorResponse(res, 400, 'Please provide name, email, phone, and password');\line     \}\line     if (password.length < 8) \{\line       return errorResponse(res, 400, 'Password must be at least 8 characters long');\line     \}\line     if (!['patient', 'doctor'].includes(role)) \{\line       return errorResponse(res, 400, 'Invalid registration role. Allowed: patient, doctor');\line     \}\line \line     const normalizedEmail = email.toLowerCase().trim();\line     if (await User.findOne(\{ email: normalizedEmail \})) \{\line       return errorResponse(res, 400, 'An account with this email address already exists');\line     \}\line \line     // Doctor license validation\line     if (role === 'doctor') \{\line       const \{ licenseNumber, specialization, qualification, hospitalOrClinic \} = profileFields;\line       if (!licenseNumber || !specialization || !qualification || !hospitalOrClinic) \{\line         return errorResponse(res, 400, 'Doctor registration requires license, specialization, qualification, and clinic');\line       \}\line       if (await Doctor.findOne(\{ licenseNumber \})) \{\line         return errorResponse(res, 400, 'A doctor account with this license number already exists');\line       \}\line     \}\line \line     const user = await User.create(\{\line       name, email: normalizedEmail, phone, password, role, isActive: true\line     \});\line \line     // Create role-specific profile\line     let profile = null;\line     if (role === 'patient') \{\line       profile = await Patient.create(\{\line         userId: user._id,\line         dateOfBirth: profileFields.dateOfBirth || null,\line         gender: profileFields.gender || 'male',\line         bloodGroup: profileFields.bloodGroup || 'Unknown',\line         address: profileFields.address || \{\}\line       \});\line     \} else if (role === 'doctor') \{\line       profile = await Doctor.create(\{\line         userId: user._id,\line         specialization: profileFields.specialization,\line         qualification: profileFields.qualification,\line         licenseNumber: profileFields.licenseNumber,\line         hospitalOrClinic: profileFields.hospitalOrClinic,\line         approvalStatus: 'pending' // Mandatory: Doctors require admin approval\line       \});\line     \}\line \line     const token = generateToken(user._id, user.role);\line     return successResponse(res, 201, 'Registration successful', \{\line       user: \{ id: user._id, name: user.name, email: user.email, role: user.role \},\line       profile,\line       token\line     \});\line   \} catch (error) \{\line     return errorResponse(res, 500, error.message);\line   \}\line \};\line\line ----------------------------------------------------------------------\line\line \b 5.2.7 Login & JWT Issuance (authController.js)\b0\line\line const login = async (req, res) => \{\line   try \{\line     const \{ email, password \} = req.body;\line     if (!email || !password) \{\line       return errorResponse(res, 400, 'Please provide both email and password');\line     \}\line \line     const user = await User.findOne(\{ email: email.toLowerCase().trim() \}).select('+password');\line     if (!user || !(await user.matchPassword(password))) \{\line       return errorResponse(res, 401, 'Invalid email or password');\line     \}\line     if (!user.isActive) \{\line       return errorResponse(res, 403, 'Account deactivated. Please contact administrator.');\line     \}\line \line     let profile = user.role === 'patient'\line       ? await Patient.findOne(\{ userId: user._id \})\line       : await Doctor.findOne(\{ userId: user._id \});\line \line     const token = generateToken(user._id, user.role);\line \line     return successResponse(res, 200, 'Login successful', \{\line       user: \{ id: user._id, name: user.name, email: user.email, role: user.role \},\line       profile,\line       token\line     \});\line   \} catch (error) \{\line     return errorResponse(res, 500, error.message);\line   \}\line \};\line\line ----------------------------------------------------------------------\line\line \b 5.2.8 Authentication & Role Middleware (authMiddleware.js & roleMiddleware.js)\b0\line\line // backend/src/middleware/authMiddleware.js\line const jwt = require('jsonwebtoken');\line const User = require('../models/User');\line const \{ errorResponse \} = require('../utils/apiResponse');\line \line const protect = async (req, res, next) => \{\line   let token;\line   if (req.headers.authorization && req.headers.authorization.startsWith('Bearer')) \{\line     try \{\line       token = req.headers.authorization.split(' ')[1];\line       const decoded = jwt.verify(token, process.env.JWT_SECRET);\line       \line       // Attach verified user without password hash\line       const user = await User.findById(decoded.id).select('-password');\line       if (!user) return errorResponse(res, 401, 'User account no longer exists');\line       if (!user.isActive) return errorResponse(res, 403, 'User account is suspended');\line \line       req.user = user;\line       return next();\line     \} catch \{\line       return errorResponse(res, 401, 'Not authorized, token verification failed');\line     \}\line   \}\line   return errorResponse(res, 401, 'Not authorized, no bearer token provided');\line \};\line \line // backend/src/middleware/roleMiddleware.js\line const authorize = (...roles) => \{\line   return (req, res, next) => \{\line     if (!req.user || !roles.includes(req.user.role)) \{\line       return errorResponse(res, 403, `Access denied: role '$\{req.user?.role\}' is unauthorized`);\line     \}\line     next();\line   \};\line \};\line \line module.exports = \{ protect, authorize \};\line\line ----------------------------------------------------------------------\line\line \b 5.2.9 CRUD API Pattern with Conflict Prevention (appointmentController.js)\b0\line\line const createAppointment = async (req, res) => \{\line   try \{\line     const \{ doctorId, appointmentDate, appointmentTime, reason \} = req.body;\line \line     // 1. Resolve patient profile from auth identity (prevents client spoofing)\line     const patient = await Patient.findOne(\{ userId: req.user._id \});\line     if (!patient) return errorResponse(res, 404, 'Patient profile not found');\line \line     // 2. Validate doctor exists and is administratively approved\line     const doctor = await Doctor.findById(doctorId);\line     if (!doctor || doctor.approvalStatus !== 'approved') \{\line       return errorResponse(res, 400, 'Appointments can only be booked with verified doctors');\line     \}\line \line     // 3. Conflict Prevention: Ensure slot is not double-booked\line     const parsedDate = new Date(appointmentDate);\line     const startOfDay = new Date(parsedDate.setHours(0, 0, 0, 0));\line     const endOfDay = new Date(parsedDate.setHours(23, 59, 59, 999));\line \line     const existingConflict = await Appointment.findOne(\{\line       doctorId: doctor._id,\line       appointmentDate: \{ $gte: startOfDay, $lte: endOfDay \},\line       appointmentTime: appointmentTime.trim(),\line       status: \{ $in: ['pending', 'confirmed'] \}\line     \});\line \line     if (existingConflict) \{\line       return errorResponse(res, 409, 'Doctor is already booked at this time slot');\line     \}\line \line     // 4. Create appointment record\line     const appointment = await Appointment.create(\{\line       patientId: patient._id,\line       doctorId: doctor._id,\line       appointmentDate: parsedDate,\line       appointmentTime: appointmentTime.trim(),\line       reason,\line       status: 'pending'\line     \});\line \line     return successResponse(res, 201, 'Appointment request submitted', appointment);\line   \} catch (error) \{\line     return errorResponse(res, 500, error.message);\line   \}\line \};\line\line ----------------------------------------------------------------------\line\line \b 5.2.10 Express Application & Server Bootstrap (app.js & server.js)\b0\line\line // backend/src/app.js\line const express = require('express');\line const cors = require('cors');\line const path = require('path');\line const \{ notFound, errorHandler \} = require('./middleware/errorMiddleware');\line \line const app = express();\line \line app.use(cors(\{ origin: process.env.CLIENT_URL || 'http://localhost:5173', credentials: true \}));\line app.use(express.json());\line app.use(express.urlencoded(\{ extended: true \}));\line app.use('/uploads', express.static(path.join(__dirname, '..', 'uploads')));\line \line // Mount Module Routes\line app.use('/api/auth', require('./routes/authRoutes'));\line app.use('/api/patients', require('./routes/patientRoutes'));\line app.use('/api/doctors', require('./routes/doctorRoutes'));\line app.use('/api/appointments', require('./routes/appointmentRoutes'));\line app.use('/api/medical-records', require('./routes/medicalRecordRoutes'));\line app.use('/api/prescriptions', require('./routes/prescriptionRoutes'));\line app.use('/api/reports', require('./routes/medicalReportRoutes'));\line app.use('/api/messages', require('./routes/messageRoutes'));\line app.use('/api/notifications', require('./routes/notificationRoutes'));\line app.use('/api/admin', require('./routes/adminRoutes'));\line \line app.use(notFound);\line app.use(errorHandler);\line \line module.exports = app;\line \line // backend/src/server.js\line require('dotenv').config();\line const http = require('http');\line const app = require('./app');\line const connectDB = require('./config/db');\line const seedAdmin = require('./utils/seedAdmin');\line const seedDemoData = require('./utils/seedDemoData');\line \line const PORT = process.env.PORT || 5000;\line \line connectDB().then(async () => \{\line   await seedAdmin();    // Guarantees admin account exists\line   await seedDemoData(); // Seeds initial doctors and patients for live demo\line   http.createServer(app).listen(PORT, () => \{\line     console.log(`[GramaCare Backend] Listening on port $\{PORT\}`);\line   \});\line \}).catch(err => \{\line   console.error('[Fatal] Server failed to start:', err.message);\line   process.exit(1);\line \});\line\line ----------------------------------------------------------------------\line\line \b 5.2.11 Frontend Axios Service & Token Interceptors (api.js)\b0\line\line import axios from 'axios';\line \line const api = axios.create(\{\line   baseURL: 'http://localhost:5000/api',\line   headers: \{ 'Content-Type': 'application/json' \}\line \});\line \line // Request Interceptor: Attach JWT Token\line api.interceptors.request.use((config) => \{\line   const token = localStorage.getItem('gramacare_token');\line   if (token) \{\line     config.headers.Authorization = `Bearer $\{token\}`;\line   \}\line   return config;\line \});\line \line // Response Interceptor: Catch Token Expiry\line api.interceptors.response.use(\line   (response) => response,\line   (error) => \{\line     if (error.response && error.response.status === 401) \{\line       if (!error.config.url.includes('/auth/login')) \{\line         localStorage.removeItem('gramacare_token');\line         localStorage.removeItem('gramacare_user');\line         window.location.href = '/login';\line       \}\line     \}\line     return Promise.reject(error);\line   \}\line );\line \line export default api;\line\line ----------------------------------------------------------------------\line\line \b 5.2.12 Admin Analytics Dashboard Logic (AdminDashboard.jsx)\b0\line\line import React, \{ useState, useEffect \} from 'react';\line import \{ getAdminStats \} from '../../services/adminService';\line \line const AdminDashboard = () => \{\line   const [data, setData] = useState(null);\line   const [loading, setLoading] = useState(true);\line \line   const fetchStats = async () => \{\line     try \{\line       setLoading(true);\line       const res = await getAdminStats();\line       if (res.success) \{\line         setData(res.data);\line       \}\line     \} catch (err) \{\line       console.error('Failed to load platform stats:', err);\line     \} finally \{\line       setLoading(false);\line     \}\line   \};\line \line   useEffect(() => \{\line     fetchStats();\line   \}, []);\line \line   if (loading) return <div>Aggregating platform intelligence...</div>;\line   const counts = data?.counts || \{\};\line \line   return (\line     <div>\line       <h3>Total Users: \{counts.totalUsers\}</h3>\line       <h3>Verified Doctors: \{counts.approvedDoctors\}</h3>\line       <h3>Pending Verifications: \{counts.pendingDoctors\}</h3>\line       <h3>Total Appointments: \{counts.totalAppointments\}</h3>\line     </div>\line   );\line \};\line \line export default AdminDashboard;\line\line ----------------------------------------------------------------------\line\line \b 5.2.13 Standard REST API Request & Response (POST /api/appointments)\b0\line\line HTTP Request:\line POST /api/appointments HTTP/1.1\line Host: localhost:5000\line Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\line Content-Type: application/json\line \line \{\line   "doctorId": "670f8b1a8d432b0012e8f192",\line   "appointmentDate": "2026-10-25",\line   "appointmentTime": "10:30 AM",\line   "reason": "Persistent dry cough and mild fever"\line \}\line \line HTTP Response (201 Created):\line \{\line   "success": true,\line   "message": "Appointment request submitted",\line   "data": \{\line     "_id": "67123fa97e0129bc4512e081",\line     "patientId": "670f8b1a8d432b0012e8f185",\line     "doctorId": "670f8b1a8d432b0012e8f192",\line     "appointmentDate": "2026-10-25T00:00:00.000Z",\line     "appointmentTime": "10:30 AM",\line     "reason": "Persistent dry cough and mild fever",\line     "status": "pending",\line     "createdAt": "2026-10-17T14:15:00.000Z",\line     "updatedAt": "2026-10-17T14:15:00.000Z"\line   \}\line \}\line \line HTTP Response on Conflict (409 Conflict):\line \{\line   "success": false,\line   "message": "Doctor is already booked at this time slot"\line \}\line\line ----------------------------------------------------------------------\line\line }