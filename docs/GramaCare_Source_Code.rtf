{\rtf1\ansi\deff0{\fonttbl{\f0 Times New Roman;}}\f0\fs28 \b SOURCE CODE IMPLEMENTATION\b0\line \b GRAMACARE - RURAL HEALTHCARE MANAGEMENT PLATFORM\b0\line\line \b 1. Project Structure\b0\line\line Project Folder Structure – GramaCare\line \line gramacare/\line │\line ├── backend/\line │   ├── src/\line │   │   ├── config/\line │   │   │   └── db.js                 # MongoDB connection & reconnection handler\line │   │   ├── controllers/\line │   │   │   ├── authController.js      # Register, login, getMe, logout\line │   │   │   ├── patientController.js   # Patient profile & health summary\line │   │   │   ├── doctorController.js    # Doctor profile, queue & patient directory\line │   │   │   ├── appointmentController.js # Booking, conflict prevention & status transitions\line │   │   │   ├── medicalRecordController.js # Clinical EHR note creation & history\line │   │   │   ├── prescriptionController.js # Multi-medicine digital Rx generator\line │   │   │   ├── medicalReportController.js # Multer file upload & report viewing\line │   │   │   ├── messageController.js   # Doctor-patient consultative chat\line │   │   │   ├── notificationController.js # Event alerts & read status updates\line │   │   │   └── adminController.js     # Platform analytics, doctor audits & user toggles\line │   │   ├── middleware/\line │   │   │   ├── authMiddleware.js      # JWT token extraction & verification (protect)\line │   │   │   ├── roleMiddleware.js      # Role-based access control (authorize)\line │   │   │   └── errorMiddleware.js     # Centralized 404 & error handlers\line │   │   ├── models/\line │   │   │   ├── User.js\line │   │   │   ├── Patient.js\line │   │   │   ├── Doctor.js\line │   │   │   ├── Appointment.js\line │   │   │   ├── MedicalRecord.js\line │   │   │   ├── Prescription.js\line │   │   │   ├── MedicalReport.js\line │   │   │   ├── Message.js\line │   │   │   └── Notification.js\line │   │   ├── routes/\line │   │   │   ├── authRoutes.js\line │   │   │   ├── patientRoutes.js\line │   │   │   ├── doctorRoutes.js\line │   │   │   ├── appointmentRoutes.js\line │   │   │   ├── medicalRecordRoutes.js\line │   │   │   ├── prescriptionRoutes.js\line │   │   │   ├── medicalReportRoutes.js\line │   │   │   ├── messageRoutes.js\line │   │   │   ├── notificationRoutes.js\line │   │   │   └── adminRoutes.js\line │   │   ├── services/\line │   │   │   └── notificationService.js\line │   │   ├── utils/\line │   │   │   ├── apiResponse.js         # Centralized success/error JSON wrappers\line │   │   │   ├── generateToken.js       # Signed JWT generator\line │   │   │   ├── seedAdmin.js           # Default platform admin seeder\line │   │   │   └── seedDemoData.js        # Verified doctor & rural patient demo seeders\line │   │   ├── app.js                     # Express middleware & route mounting\line │   │   └── server.js                  # HTTP server bootstrap & DB initialization\line │   ├── uploads/\line │   │   └── reports/                   # Secure storage for medical reports\line │   ├── .env\line │   ├── package.json\line │   └── tests/\line │\line └── frontend/\line     ├── src/\line     │   ├── components/\line     │   │   └── common/\line     │   │       ├── Navbar.jsx\line     │   │       └── Footer.jsx\line     │   ├── context/\line     │   │   └── AuthContext.jsx        # Global session provider & demo auto-login\line     │   ├── hooks/\line     │   │   └── useAuth.js             # AuthContext consumer hook\line     │   ├── layouts/\line     │   │   ├── PatientLayout.jsx      # Patient portal sidebar & shell\line     │   │   ├── DoctorLayout.jsx       # Doctor clinical workspace sidebar\line     │   │   └── AdminLayout.jsx        # Admin governance console sidebar\line     │   ├── pages/\line     │   │   ├── public/\line     │   │   │   ├── LandingPage.jsx\line     │   │   │   ├── Login.jsx\line     │   │   │   ├── Register.jsx\line     │   │   │   └── Unauthorized.jsx\line     │   │   ├── patient/\line     │   │   │   ├── PatientDashboard.jsx\line     │   │   │   ├── PatientAppointments.jsx\line     │   │   │   ├── PatientRecords.jsx\line     │   │   │   ├── PatientPrescriptions.jsx\line     │   │   │   ├── PatientReports.jsx\line     │   │   │   └── PatientMessages.jsx\line     │   │   ├── doctor/\line     │   │   │   ├── DoctorDashboard.jsx\line     │   │   │   ├── DoctorAppointments.jsx\line     │   │   │   ├── DoctorPatients.jsx\line     │   │   │   ├── DoctorConsultation.jsx\line     │   │   │   ├── DoctorPrescriptions.jsx\line     │   │   │   └── DoctorMessages.jsx\line     │   │   └── admin/\line     │   │       ├── AdminDashboard.jsx\line     │   │       ├── AdminDoctors.jsx\line     │   │       ├── AdminUsers.jsx\line     │   │       └── AdminAppointments.jsx\line     │   ├── routes/\line     │   │   ├── AppRoutes.jsx          # Declarative React Router v7 configuration\line     │   │   └── ProtectedRoute.jsx     # Route guard wrapper\line     │   ├── services/\line     │   │   ├── api.js                 # Centralized Axios client with JWT interceptors\line     │   │   ├── authService.js\line     │   │   ├── patientService.js\line     │   │   ├── doctorService.js\line     │   │   └── adminService.js\line     │   ├── App.jsx\line     │   ├── main.jsx\line     │   └── index.css\line     ├── package.json\line     ├── tailwind.config.js\line     └── index.html\line\line ----------------------------------------------------------------------\line\line \b 2. Backend Package Installation\b0\line\line # Initialize backend Node.js project\line npm init -y\line \line # Install production dependencies\line npm install express mongoose dotenv cors jsonwebtoken bcryptjs multer\line \line # Install development dependency for live server auto-reloading\line npm install --save-dev nodemon\line \line # Start backend server in development mode\line npm run dev\line\line ----------------------------------------------------------------------\line\line \b 3. Database Connection\b0\line\line // backend/src/config/db.js\line const mongoose = require('mongoose');\line \line const connectDB = async () => \{\line   try \{\line     const mongoUri = process.env.MONGO_URI || 'mongodb://127.0.0.1:27017/gramacare';\line     const conn = await mongoose.connect(mongoUri);\line     console.log(`[MongoDB] Connected successfully: $\{conn.connection.host\}/$\{conn.connection.name\}`);\line   \} catch (error) \{\line     console.error(`[MongoDB] Connection error: $\{error.message\}`);\line     process.exit(1);\line   \}\line \};\line \line mongoose.connection.on('disconnected', () => \{\line   console.warn('[MongoDB] Connection lost. Attempting reconnection...');\line \});\line \line module.exports = connectDB;\line\line ----------------------------------------------------------------------\line\line \b 4. Environment Variables\b0\line\line # backend/.env and .env.example\line \line # Backend Server Configuration\line PORT=5000\line NODE_ENV=development\line \line # Database Configuration\line MONGO_URI=mongodb://127.0.0.1:27017/gramacare\line \line # JWT Authentication Configuration\line JWT_SECRET=gramacare_super_secret_jwt_key_2026_rural_health\line JWT_EXPIRE=7d\line \line # Client Application URL for CORS Whitelisting\line CLIENT_URL=http://localhost:5173\line\line ----------------------------------------------------------------------\line\line \b 5. User Model\b0\line\line // backend/src/models/User.js\line const mongoose = require('mongoose');\line const bcrypt = require('bcryptjs');\line \line const userSchema = new mongoose.Schema(\line   \{\line     name: \{\line       type: String,\line       required: [true, 'Please provide a full name'],\line       trim: true\line     \},\line     email: \{\line       type: String,\line       required: [true, 'Please provide an email address'],\line       unique: true,\line       lowercase: true,\line       trim: true,\line       match: [\line         /^\\w+([\\.-]?\\w+)*@\\w+([\\.-]?\\w+)*(\\.\\w\{2,3\})+$/,\line         'Please provide a valid email address'\line       ]\line     \},\line     phone: \{\line       type: String,\line       required: [true, 'Please provide a contact phone number'],\line       trim: true\line     \},\line     password: \{\line       type: String,\line       required: [true, 'Please provide a password'],\line       minlength: [8, 'Password must be at least 8 characters long'],\line       select: false // Excluded from default queries for security\line     \},\line     role: \{\line       type: String,\line       enum: ['patient', 'doctor', 'admin'],\line       default: 'patient',\line       required: true\line     \},\line     isActive: \{\line       type: Boolean,\line       default: true\line     \}\line   \},\line   \{ timestamps: true \}\line );\line \line // Encrypt password before saving using bcrypt salt\line userSchema.pre('save', async function () \{\line   if (!this.isModified('password')) return;\line   const salt = await bcrypt.genSalt(10);\line   this.password = await bcrypt.hash(this.password, salt);\line \});\line \line // Compare entered password with stored hash\line userSchema.methods.matchPassword = async function (enteredPassword) \{\line   return await bcrypt.compare(enteredPassword, this.password);\line \};\line \line module.exports = mongoose.model('User', userSchema);\line\line ----------------------------------------------------------------------\line\line \b 6. Password Hashing and Registration\b0\line\line // backend/src/controllers/authController.js (register)\line const User = require('../models/User');\line const Patient = require('../models/Patient');\line const Doctor = require('../models/Doctor');\line const generateToken = require('../utils/generateToken');\line const \{ successResponse, errorResponse \} = require('../utils/apiResponse');\line \line const register = async (req, res) => \{\line   try \{\line     const \{ name, email, phone, password, role = 'patient', ...profileFields \} = req.body;\line \line     if (!name || !email || !phone || !password) \{\line       return errorResponse(res, 400, 'Please provide name, email, phone, and password');\line     \}\line     if (password.length < 8) \{\line       return errorResponse(res, 400, 'Password must be at least 8 characters long');\line     \}\line     if (!['patient', 'doctor'].includes(role)) \{\line       return errorResponse(res, 400, 'Invalid registration role. Allowed: patient, doctor');\line     \}\line \line     const normalizedEmail = email.toLowerCase().trim();\line     if (await User.findOne(\{ email: normalizedEmail \})) \{\line       return errorResponse(res, 400, 'An account with this email address already exists');\line     \}\line \line     // Doctor specific license uniqueness check\line     if (role === 'doctor') \{\line       const \{ licenseNumber, specialization, qualification, hospitalOrClinic \} = profileFields;\line       if (!licenseNumber || !specialization || !qualification || !hospitalOrClinic) \{\line         return errorResponse(res, 400, 'Doctor registration requires license, specialization, qualification, and clinic');\line       \}\line       if (await Doctor.findOne(\{ licenseNumber \})) \{\line         return errorResponse(res, 400, 'A doctor account with this license number already exists');\line       \}\line     \}\line \line     // Password is automatically hashed via userSchema.pre('save')\line     const user = await User.create(\{\line       name, email: normalizedEmail, phone, password, role, isActive: true\line     \});\line \line     // Create role-specific profile document\line     let profile = null;\line     if (role === 'patient') \{\line       profile = await Patient.create(\{\line         userId: user._id,\line         dateOfBirth: profileFields.dateOfBirth || null,\line         gender: profileFields.gender || 'male',\line         bloodGroup: profileFields.bloodGroup || 'Unknown',\line         address: profileFields.address || \{\}\line       \});\line     \} else if (role === 'doctor') \{\line       profile = await Doctor.create(\{\line         userId: user._id,\line         specialization: profileFields.specialization,\line         qualification: profileFields.qualification,\line         licenseNumber: profileFields.licenseNumber,\line         hospitalOrClinic: profileFields.hospitalOrClinic,\line         approvalStatus: 'pending' // Mandatory: Doctors require admin approval\line       \});\line     \}\line \line     const token = generateToken(user._id, user.role);\line     return successResponse(res, 201, 'Registration successful', \{\line       user: \{ id: user._id, name: user.name, email: user.email, role: user.role \},\line       profile,\line       token\line     \});\line   \} catch (error) \{\line     return errorResponse(res, 500, error.message);\line   \}\line \};\line\line ----------------------------------------------------------------------\line\line \b 7. Login and JWT Generation\b0\line\line // backend/src/controllers/authController.js (login) & utils/generateToken.js\line const jwt = require('jsonwebtoken');\line \line // Token Generator Helper\line const generateToken = (id, role) => \{\line   return jwt.sign(\line     \{ id, role \},\line     process.env.JWT_SECRET || 'gramacare_super_secret_jwt_key_2026_rural_health',\line     \{ expiresIn: process.env.JWT_EXPIRE || '7d' \}\line   );\line \};\line \line // Login Controller\line const login = async (req, res) => \{\line   try \{\line     const \{ email, password \} = req.body;\line     if (!email || !password) \{\line       return errorResponse(res, 400, 'Please provide both email and password');\line     \}\line \line     const user = await User.findOne(\{ email: email.toLowerCase().trim() \}).select('+password');\line     if (!user || !(await user.matchPassword(password))) \{\line       return errorResponse(res, 401, 'Invalid email or password');\line     \}\line     if (!user.isActive) \{\line       return errorResponse(res, 403, 'Your account has been deactivated. Please contact administrator.');\line     \}\line \line     let profile = user.role === 'patient'\line       ? await Patient.findOne(\{ userId: user._id \})\line       : await Doctor.findOne(\{ userId: user._id \});\line \line     const token = generateToken(user._id, user.role);\line \line     return successResponse(res, 200, 'Login successful', \{\line       user: \{ id: user._id, name: user.name, email: user.email, role: user.role \},\line       profile,\line       token\line     \});\line   \} catch (error) \{\line     return errorResponse(res, 500, error.message);\line   \}\line \};\line\line ----------------------------------------------------------------------\line\line \b 8. Authentication Middleware\b0\line\line // backend/src/middleware/authMiddleware.js\line const jwt = require('jsonwebtoken');\line const User = require('../models/User');\line const \{ errorResponse \} = require('../utils/apiResponse');\line \line const protect = async (req, res, next) => \{\line   let token;\line   if (req.headers.authorization && req.headers.authorization.startsWith('Bearer')) \{\line     try \{\line       token = req.headers.authorization.split(' ')[1];\line       const decoded = jwt.verify(token, process.env.JWT_SECRET || 'gramacare_super_secret_jwt_key_2026_rural_health');\line       \line       const user = await User.findById(decoded.id).select('-password');\line       if (!user) return errorResponse(res, 401, 'User account no longer exists');\line       if (!user.isActive) return errorResponse(res, 403, 'User account is suspended');\line \line       req.user = user;\line       return next();\line     \} catch (error) \{\line       return errorResponse(res, 401, 'Not authorized, token verification failed');\line     \}\line   \}\line   return errorResponse(res, 401, 'Not authorized, no bearer token provided');\line \};\line \line // Role-Based Authorization Middleware\line const authorize = (...roles) => \{\line   return (req, res, next) => \{\line     if (!req.user || !roles.includes(req.user.role)) \{\line       return errorResponse(res, 403, `Access denied: role '$\{req.user?.role\}' is unauthorized`);\line     \}\line     next();\line   \};\line \};\line \line module.exports = \{ protect, authorize \};\line\line ----------------------------------------------------------------------\line\line \b 9. Create API\b0\line\line // backend/src/controllers/appointmentController.js (createAppointment)\line // Demonstrates data validation, patient identity resolution, doctor verification, and double-booking prevention\line const createAppointment = async (req, res) => \{\line   try \{\line     const \{ doctorId, appointmentDate, appointmentTime, reason, notes \} = req.body;\line \line     if (!doctorId || !appointmentDate || !appointmentTime || !reason) \{\line       return errorResponse(res, 400, 'Please provide doctor, date, time, and reason for consultation');\line     \}\line \line     // 1. Resolve patient profile strictly from auth token identity\line     const patient = await Patient.findOne(\{ userId: req.user._id \});\line     if (!patient) return errorResponse(res, 404, 'Patient profile not found');\line \line     // 2. Validate doctor existence and approval status\line     const doctor = await Doctor.findById(doctorId).populate('userId', 'name');\line     if (!doctor || doctor.approvalStatus !== 'approved') \{\line       return errorResponse(res, 400, 'Appointments can only be booked with approved healthcare doctors');\line     \}\line \line     // 3. Slot Conflict Prevention (prevents double-booking same date & time)\line     const parsedDate = new Date(appointmentDate);\line     const startOfDay = new Date(parsedDate.setHours(0, 0, 0, 0));\line     const endOfDay = new Date(parsedDate.setHours(23, 59, 59, 999));\line \line     const existingConflict = await Appointment.findOne(\{\line       doctorId: doctor._id,\line       appointmentDate: \{ $gte: startOfDay, $lte: endOfDay \},\line       appointmentTime: appointmentTime.trim(),\line       status: \{ $in: ['pending', 'confirmed'] \}\line     \});\line \line     if (existingConflict) \{\line       return errorResponse(res, 409, `Doctor is already booked at $\{appointmentTime\} on this date`);\line     \}\line \line     // 4. Create appointment in database\line     const appointment = await Appointment.create(\{\line       patientId: patient._id,\line       doctorId: doctor._id,\line       appointmentDate: parsedDate,\line       appointmentTime: appointmentTime.trim(),\line       reason,\line       notes: notes || '',\line       status: 'pending'\line     \});\line \line     return successResponse(res, 201, 'Appointment request created successfully', appointment);\line   \} catch (error) \{\line     return errorResponse(res, 500, error.message);\line   \}\line \};\line\line ----------------------------------------------------------------------\line\line \b 10. Read API\b0\line\line // backend/src/controllers/appointmentController.js (getAppointments & getAppointmentById)\line // Enforces role-based isolation (patients only view their records, doctors only view their clinic visits)\line const getAppointments = async (req, res) => \{\line   try \{\line     let filter = \{\};\line \line     if (req.user.role === 'patient') \{\line       const patient = await Patient.findOne(\{ userId: req.user._id \});\line       if (!patient) return errorResponse(res, 404, 'Patient profile not found');\line       filter.patientId = patient._id;\line     \} else if (req.user.role === 'doctor') \{\line       const doctor = await Doctor.findOne(\{ userId: req.user._id \});\line       if (!doctor) return errorResponse(res, 404, 'Doctor profile not found');\line       filter.doctorId = doctor._id;\line     \}\line \line     const appointments = await Appointment.find(filter)\line       .sort(\{ appointmentDate: -1, appointmentTime: 1 \})\line       .populate(\{ path: 'doctorId', populate: \{ path: 'userId', select: 'name email phone' \} \})\line       .populate(\{ path: 'patientId', populate: \{ path: 'userId', select: 'name email phone' \} \});\line \line     return successResponse(res, 200, 'Appointments retrieved successfully', appointments);\line   \} catch (error) \{\line     return errorResponse(res, 500, error.message);\line   \}\line \};\line \line const getAppointmentById = async (req, res) => \{\line   try \{\line     const appointment = await Appointment.findById(req.params.id)\line       .populate(\{ path: 'doctorId', populate: \{ path: 'userId', select: 'name email phone' \} \})\line       .populate(\{ path: 'patientId', populate: \{ path: 'userId', select: 'name email phone' \} \});\line \line     if (!appointment) return errorResponse(res, 404, 'Appointment not found');\line     return successResponse(res, 200, 'Appointment details retrieved', appointment);\line   \} catch (error) \{\line     return errorResponse(res, 500, error.message);\line   \}\line \};\line\line ----------------------------------------------------------------------\line\line \b 11. Update\b0\line\line // backend/src/controllers/appointmentController.js (updateAppointmentStatus)\line // Handles status transitions: pending -> confirmed, rejected, or completed\line const updateAppointmentStatus = async (req, res) => \{\line   try \{\line     const \{ status, notes \} = req.body;\line     if (!status || !['confirmed', 'rejected', 'completed', 'cancelled'].includes(status)) \{\line       return errorResponse(res, 400, 'Invalid appointment status');\line     \}\line \line     const appointment = await Appointment.findById(req.params.id);\line     if (!appointment) \{\line       return errorResponse(res, 404, 'Appointment not found');\line     \}\line \line     // Business Rule: Cancelled appointments cannot be completed\line     if (appointment.status === 'cancelled' && status === 'completed') \{\line       return errorResponse(res, 400, 'Cancelled appointments cannot be marked completed');\line     \}\line \line     appointment.status = status;\line     if (notes) appointment.notes = notes;\line     await appointment.save();\line \line     return successResponse(res, 200, `Appointment marked as $\{status\}`, appointment);\line   \} catch (error) \{\line     return errorResponse(res, 500, error.message);\line   \}\line \};\line\line ----------------------------------------------------------------------\line\line \b 12. Delete\b0\line\line // backend/src/controllers/medicalReportController.js (deleteReport) & appointment cancel\line // Deletes both the database metadata record and the physical binary file from disk\line const deleteReport = async (req, res) => \{\line   try \{\line     const report = await MedicalReport.findById(req.params.id);\line     if (!report) \{\line       return errorResponse(res, 404, 'Report not found');\line     \}\line \line     const patient = await Patient.findOne(\{ userId: req.user._id \});\line     if (!patient || !report.patientId.equals(patient._id)) \{\line       return errorResponse(res, 403, 'Unauthorized to delete this medical report');\line     \}\line \line     // Unlink physical file from disk storage\line     const filename = path.basename(report.fileUrl);\line     const filePath = path.join(__dirname, '..', '..', 'uploads', 'reports', filename);\line     if (fs.existsSync(filePath)) \{\line       fs.unlinkSync(filePath);\line     \}\line \line     await MedicalReport.findByIdAndDelete(report._id);\line     return successResponse(res, 200, 'Medical report deleted successfully');\line   \} catch (error) \{\line     return errorResponse(res, 500, error.message);\line   \}\line \};\line\line ----------------------------------------------------------------------\line\line \b 13. Express Routes\b0\line\line // backend/src/routes/appointmentRoutes.js\line const express = require('express');\line const \{\line   createAppointment,\line   getAppointments,\line   getAppointmentById,\line   cancelAppointment,\line   updateAppointmentStatus\line \} = require('../controllers/appointmentController');\line const \{ protect \} = require('../middleware/authMiddleware');\line const \{ authorize \} = require('../middleware/roleMiddleware');\line \line const router = express.Router();\line \line router.post('/', protect, authorize('patient'), createAppointment);\line router.get('/', protect, getAppointments);\line router.get('/:id', protect, getAppointmentById);\line router.put('/:id/cancel', protect, cancelAppointment);\line router.put('/:id/status', protect, updateAppointmentStatus);\line \line module.exports = router;\line\line ----------------------------------------------------------------------\line\line \b 14. Main Server File\b0\line\line // backend/src/app.js\line const express = require('express');\line const cors = require('cors');\line const path = require('path');\line const \{ notFound, errorHandler \} = require('./middleware/errorMiddleware');\line \line const app = express();\line \line app.use(cors(\{ origin: process.env.CLIENT_URL || 'http://localhost:5173', credentials: true \}));\line app.use(express.json());\line app.use(express.urlencoded(\{ extended: true \}));\line app.use('/uploads', express.static(path.join(__dirname, '..', 'uploads')));\line \line // Routes\line app.use('/api/auth', require('./routes/authRoutes'));\line app.use('/api/patients', require('./routes/patientRoutes'));\line app.use('/api/doctors', require('./routes/doctorRoutes'));\line app.use('/api/appointments', require('./routes/appointmentRoutes'));\line app.use('/api/medical-records', require('./routes/medicalRecordRoutes'));\line app.use('/api/prescriptions', require('./routes/prescriptionRoutes'));\line app.use('/api/reports', require('./routes/medicalReportRoutes'));\line app.use('/api/messages', require('./routes/messageRoutes'));\line app.use('/api/notifications', require('./routes/notificationRoutes'));\line app.use('/api/admin', require('./routes/adminRoutes'));\line \line app.use(notFound);\line app.use(errorHandler);\line \line module.exports = app;\line \line // backend/src/server.js\line require('dotenv').config();\line const http = require('http');\line const app = require('./app');\line const connectDB = require('./config/db');\line const seedAdmin = require('./utils/seedAdmin');\line const seedDemoData = require('./utils/seedDemoData');\line \line const PORT = process.env.PORT || 5000;\line \line connectDB().then(async () => \{\line   await seedAdmin();\line   await seedDemoData();\line   http.createServer(app).listen(PORT, () => \{\line     console.log(`[GramaCare Backend] Listening on port $\{PORT\}`);\line   \});\line \}).catch(err => \{\line   console.error('[Fatal] Server failed to start:', err.message);\line   process.exit(1);\line \});\line\line ----------------------------------------------------------------------\line\line \b 15. React Login Component\b0\line\line // frontend/src/pages/public/Login.jsx\line import React, \{ useState \} from 'react';\line import \{ useNavigate, useLocation, Link \} from 'react-router-dom';\line import useAuth from '../../hooks/useAuth';\line import \{ HeartPulse, Lock, Mail, AlertCircle, ArrowRight \} from 'lucide-react';\line \line const Login = () => \{\line   const [email, setEmail] = useState('');\line   const [password, setPassword] = useState('');\line   const [localError, setLocalError] = useState('');\line   const [submitting, setSubmitting] = useState(false);\line \line   const \{ login \} = useAuth();\line   const navigate = useNavigate();\line   const location = useLocation();\line \line   const handleSubmit = async (e) => \{\line     e.preventDefault();\line     setLocalError('');\line \line     if (!email || !password) \{\line       setLocalError('Please enter both email address and password');\line       return;\line     \}\line \line     setSubmitting(true);\line     const result = await login(email, password);\line     setSubmitting(false);\line \line     if (result.success) \{\line       const role = result.user.role;\line       const redirectPath = location.state?.from?.pathname || (\line         role === 'doctor' ? '/doctor/dashboard' :\line         role === 'admin' ? '/admin/dashboard' :\line         '/patient/dashboard'\line       );\line       navigate(redirectPath, \{ replace: true \});\line     \} else \{\line       setLocalError(result.message || 'Invalid credentials');\line     \}\line   \};\line \line   return (\line     <div className="min-h-screen flex items-center justify-center bg-slate-50 p-4">\line       <div className="max-w-md w-full bg-white p-8 rounded-2xl shadow-sm border border-slate-200">\line         <h2 className="text-2xl font-black text-slate-900 text-center mb-6">Sign In to GramaCare</h2>\line         \{localError && (\line           <div className="p-3 mb-4 rounded-xl bg-rose-50 text-rose-700 text-xs flex items-center gap-2">\line             <AlertCircle className="w-4 h-4 flex-shrink-0" />\line             <span>\{localError\}</span>\line           </div>\line         )\}\line         <form onSubmit=\{handleSubmit\} className="space-y-4">\line           <div>\line             <label className="block text-xs font-bold text-slate-700 mb-1">Email Address</label>\line             <input\line               type="email"\line               required\line               value=\{email\}\line               onChange=\{(e) => setEmail(e.target.value)\}\line               className="w-full p-2.5 border border-slate-200 rounded-xl text-sm"\line               placeholder="name@example.com"\line             />\line           </div>\line           <div>\line             <label className="block text-xs font-bold text-slate-700 mb-1">Password</label>\line             <input\line               type="password"\line               required\line               value=\{password\}\line               onChange=\{(e) => setPassword(e.target.value)\}\line               className="w-full p-2.5 border border-slate-200 rounded-xl text-sm"\line               placeholder="••••••••"\line             />\line           </div>\line           <button\line             type="submit"\line             disabled=\{submitting\}\line             className="w-full py-3 bg-emerald-600 text-white rounded-xl font-bold text-sm hover:bg-emerald-700 transition"\line           >\line             \{submitting ? 'Signing in...' : 'Sign In'\}\line           </button>\line         </form>\line       </div>\line     </div>\line   );\line \};\line \line export default Login;\line\line ----------------------------------------------------------------------\line\line \b 16. Admin Dashboard Logic\b0\line\line // frontend/src/pages/admin/AdminDashboard.jsx\line import React, \{ useState, useEffect \} from 'react';\line import \{ getAdminStats \} from '../../services/adminService';\line \line const AdminDashboard = () => \{\line   const [data, setData] = useState(null);\line   const [loading, setLoading] = useState(true);\line \line   const fetchStats = async () => \{\line     try \{\line       setLoading(true);\line       const res = await getAdminStats();\line       if (res.success) \{\line         setData(res.data);\line       \}\line     \} catch (err) \{\line       console.error('Failed to load admin stats:', err);\line     \} finally \{\line       setLoading(false);\line     \}\line   \};\line \line   useEffect(() => \{\line     fetchStats();\line   \}, []);\line \line   if (loading) return <div>Aggregating platform intelligence...</div>;\line \line   const counts = data?.counts || \{\};\line   return (\line     <div className="grid grid-cols-4 gap-6">\line       <div className="p-5 bg-white rounded-2xl border">Total Users: \{counts.totalUsers\}</div>\line       <div className="p-5 bg-white rounded-2xl border">Verified Doctors: \{counts.approvedDoctors\}</div>\line       <div className="p-5 bg-white rounded-2xl border">Pending Approvals: \{counts.pendingDoctors\}</div>\line       <div className="p-5 bg-white rounded-2xl border">Total Appointments: \{counts.totalAppointments\}</div>\line     </div>\line   );\line \};\line \line export default AdminDashboard;\line\line ----------------------------------------------------------------------\line\line \b 17. REST API Request and Response Examples\b0\line\line // 1. Appointment Booking (Patient)\line HTTP Request:\line POST /api/appointments HTTP/1.1\line Host: localhost:5000\line Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\line Content-Type: application/json\line \line \{\line   "doctorId": "670f8b1a8d432b0012e8f192",\line   "appointmentDate": "2026-10-25",\line   "appointmentTime": "10:30 AM",\line   "reason": "Persistent dry cough and mild fever"\line \}\line \line HTTP Response (201 Created):\line \{\line   "success": true,\line   "message": "Appointment request created successfully",\line   "data": \{\line     "_id": "67123fa97e0129bc4512e081",\line     "patientId": "670f8b1a8d432b0012e8f185",\line     "doctorId": "670f8b1a8d432b0012e8f192",\line     "appointmentDate": "2026-10-25T00:00:00.000Z",\line     "appointmentTime": "10:30 AM",\line     "reason": "Persistent dry cough and mild fever",\line     "status": "pending",\line     "createdAt": "2026-10-17T14:15:00.000Z",\line     "updatedAt": "2026-10-17T14:15:00.000Z"\line   \}\line \}\line \line // 2. Conflict Error Response (409 Conflict):\line \{\line   "success": false,\line   "message": "Doctor is already booked at 10:30 AM on this date"\line \}\line \line // 3. Status Transition Update (Doctor)\line HTTP Request:\line PUT /api/appointments/67123fa97e0129bc4512e081/status HTTP/1.1\line Host: localhost:5000\line Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\line Content-Type: application/json\line \line \{\line   "status": "confirmed",\line   "notes": "Appointment slot confirmed. Please bring previous prescriptions."\line \}\line \line HTTP Response (200 OK):\line \{\line   "success": true,\line   "message": "Appointment marked as confirmed",\line   "data": \{\line     "_id": "67123fa97e0129bc4512e081",\line     "status": "confirmed",\line     "notes": "Appointment slot confirmed. Please bring previous prescriptions."\line   \}\line \}\line\line ----------------------------------------------------------------------\line\line }